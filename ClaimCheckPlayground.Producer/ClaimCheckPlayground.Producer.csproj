<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>producer-claim-check-demo</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire client integrations — inject BlobServiceClient / ServiceBusClient via DI -->
    <PackageReference Include="Aspire.Azure.Messaging.ServiceBus" Version="13.1.2" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.1.2" />

    <!-- OpenAPI + Scalar UI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaimCheckPlayground.Contracts\ClaimCheckPlayground.Contracts.csproj" />
    <ProjectReference Include="..\ClaimCheckPlayground.ServiceDefaults\ClaimCheckPlayground.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
