<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>processor-claim-check-demo</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire client integrations -->
    <PackageReference Include="Aspire.Azure.Messaging.ServiceBus" Version="13.4.6" />
    <PackageReference Include="Aspire.Azure.Storage.Blobs" Version="13.4.6" />

    <!-- OpenAPI + Scalar UI -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.17" />

    <!-- Pinned transitive dependencies to fix vulnerabilities -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClaimCheckPlayground.Contracts\ClaimCheckPlayground.Contracts.csproj" />
    <ProjectReference Include="..\ClaimCheckPlayground.ServiceDefaults\ClaimCheckPlayground.ServiceDefaults.csproj" />
  </ItemGroup>

</Project>
